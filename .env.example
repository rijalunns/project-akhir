# ---------- AI (endpoint kompatibel OpenAI: OpenRouter, DeepSeek, dll.) ----------
AI_ENDPOINT=https://openrouter.ai/api/v1
AI_API_KEY=YOUR_AI_API_KEY
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
# true = bot mendengarkan perintah /eksekusi_<vmid>, /abaikan_<vmid>, /pending
TELEGRAM_POLLING=true

# ---------- Proxmox (QEMU Guest Agent) ----------
PROXMOX_API_URL=https://proxmox.example.com:8006/api2/json
# Format: user@realm!tokenid=secret
PROXMOX_API_TOKEN=YOUR_PROXMOX_API_TOKEN
# Opsional: kosongkan agar node dicari otomatis
PROXMOX_NODE=
PROXMOX_VERIFY_SSL=false
# true = script tidak pernah benar-benar dijalankan (aman untuk demo)
DRY_RUN=false

# ---------- Keamanan API ----------
# Wajib diisi di production. Kirim lewat header: X-API-Key
HYPERHEAL_API_KEY=
RATE_LIMIT_PER_MINUTE=100
# Pisahkan dengan koma, kosongkan untuk menonaktifkan CORS
CORS_ORIGINS=

# ---------- Grafana (dibaca docker compose) ----------
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=ganti_password_ini

LOG_LEVEL=INFO
